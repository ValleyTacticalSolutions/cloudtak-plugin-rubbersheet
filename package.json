{
  "name": "cloudtak-plugin-rubber-sheet",
  "version": "2.0.0",
  "type": "module",
  "description": "CloudTAK plugin \u2014 rubber-sheet an image or PDF over the map and export KMZ, GeoTIFF, or GeoPDF",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/ValleyTacticalSolutions/cloudtak-plugin-rubbersheet.git"
  },
  "cloudtak": {
    "minVersion": "14.4.1"
  },
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "check": "vue-tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "verify": "bash verify-cloudtak.sh . rubber-sheet",
    "build:bundle": "vite build --config vite.bundle.config.ts",
    "bundle": "npm run build:bundle && node scripts/bundle.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tabler/icons-vue": "^3.31.0",
    "@tak-ps/vue-tabler": "^6.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^10.0.1",
    "globals": "^17.3.0",
    "maplibre-gl": "^6.16.0",
    "pinia": "^4.0.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.52.0",
    "vite": "^8.0.0",
    "vite-plugin-css-injected-by-js": "^3.5.0",
    "vue": "^3.5.26",
    "vue-router": "^5.0.0",
    "vue-tsc": "^3.2.2"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "cloudtakBundle": {
    "name": "rubber-sheet",
    "author": "ValleyTacticalSolutions",
    "homepage": "https://github.com/ValleyTacticalSolutions/cloudtak-plugin-rubbersheet"
  }
}
